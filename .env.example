APP_NAME=SageOps
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
TIMEZONE=Africa/Lagos

# Local PostgreSQL 17.10 development target; no password is embedded.
DATABASE_URL=postgresql+psycopg://sageops_app@localhost:5433/sageops
OPERATIONS_DB_WRITES_ENABLED=false

# Google OIDC administrator and staff sign-in. Store secrets only in a secret manager.
ADMIN_GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_CLIENT_SECRET=
ADMIN_GOOGLE_REDIRECT_URI=https://YOUR-SERVICE.example.com/auth/callback
ADMIN_EMAILS=
ADMIN_SESSION_SECRET=
ADMIN_COOKIE_SECURE=true
SENTRY_DSN=

# Telegram webhook and independent notification worker.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
OPERATIONS_NOTIFICATIONS_ENABLED=false
OPERATIONS_WORKER_INTERVAL_SECONDS=60
TELEGRAM_TEST_MODE=true
DRY_RUN=true

# Optional signed event receiver and PostgreSQL preflight token.
ENABLE_WEBHOOKS=false
WEBHOOK_SECRET=
WEBHOOK_MAX_SKEW_SECONDS=300
WEBHOOK_MAX_BODY_BYTES=262144
PREFLIGHT_TOKEN=

# Optional analytics integrations; unrelated to staff operations persistence.
ENABLE_ANALYTICS=false
GOOGLE_CREDS_PATH=credentials/google-analytics.json
GA4_PROPERTY_ID=
YOUTUBE_CHANNEL_ID=
YOUTUBE_API_KEY=
