APP_ENV=development
APP_NAME=Polaris
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
TIMEZONE=Africa/Lagos

TELEGRAM_BOT_TOKEN=
TELEGRAM_PUBLIC_CHAT_ID=
TELEGRAM_CORE_CHAT_ID=

GOOGLE_SHEET_ID=
# Optional credential file: service-account JSON or external-account/WIF config.
# On Render, prefer the dedicated Google OAuth refresh-token settings below.
GOOGLE_CREDS_PATH=credentials/google-service-account.json
# Configure all three OAuth values together. Store actual values only in the host's secret store.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Optional: random 32+ character secret to protect GET /admin/preflight; keep private.
PREFLIGHT_TOKEN=
ENABLE_TEAM_WORKFLOWS=false
# Separate approval gate for /goal and /blocker spreadsheet writes.
ENABLE_TEAM_WRITES=false
ENABLE_SCHEDULED_WORKFLOWS=false
ENABLE_ANALYTICS=false
ENABLE_WEBHOOKS=false
WEBHOOK_SECRET=
WEBHOOK_DB_PATH=data/polaris-webhooks.sqlite3
WEBHOOK_MAX_SKEW_SECONDS=300
WEBHOOK_MAX_BODY_BYTES=262144
JOB_DESCRIPTIONS_WORKSHEET=
BLOCKER_LOG_WORKSHEET=

GA4_PROPERTY_ID=
YOUTUBE_CHANNEL_ID=
YOUTUBE_API_KEY=

SHEET_POLL_INTERVAL_SECONDS=60
REMINDER_COOLDOWN_MINUTES=240
MAX_REMINDERS_PER_TASK_PER_DAY=2
REMINDER_RECEIPTS_DB_PATH=data/polaris-reminders.sqlite3
DRY_RUN=true
# Optional: allow only harmless /start, /help, /whoami replies while dry-run remains enabled.
ENABLE_SAFE_TELEGRAM_REPLIES=false
# Optional staging only: allow private team-command responses; DRY_RUN still blocks writes.
ENABLE_DRY_RUN_TEAM_REPLIES=false
